# Copy to .env (git-ignored) and fill in the key.
# The key is read from the environment only; never commit it.
TOKROUTER_API_KEY=
TOKROUTER_BASE_URL=https://api.tokrouter.dev

# Model defaults. Override any of these to match what your gateway exposes.
MODEL_CHAT=gpt-6.1-sol
MODEL_STREAM=deepseek-v4.1-flash
MODEL_RESPONSES=gpt-6.1-sol
MODEL_ANTHROPIC=claude-fable-5-1
MODEL_GEMINI=gemini-3.8-flash
MODEL_DASHSCOPE=qwen3.8-max
MODEL_EMBEDDING=text-embedding-v4
MODEL_RERANK=bge-m3-reranker
MODEL_IMAGE=gpt-image-2.5-sunburst
MODEL_TRANSCRIBE=whisper
MODEL_REALTIME=aliyun/qwen3.5-omni-plus-realtime
MODELS_MULTI_VENDOR=kimi-k3,glm-5.3,grok-4.7,qwen3.8-max
